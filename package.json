{
  "name": "mu-workspace",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node --import tsx packages/coding-agent/bin/coding-agent.js",
    "dev:tui-debug": "MU_TUI_DEBUG_LOG=/tmp/mu-tui.log NODE_ENV=development node --import tsx packages/coding-agent/bin/coding-agent.js",
    "start": "node --import tsx packages/coding-agent/bin/coding-agent.js",
    "lint": "biome check packages/",
    "lint:fix": "biome check --fix --unsafe packages/",
    "format": "biome format --write packages/",
    "check": "biome check packages/ && tsc -b",
    "test": "vitest run",
    "knip": "knip",
    "sg": "sg",
    "publish": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "knip": "^6.4.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "tsx": "^4.22.3"
  }
}
