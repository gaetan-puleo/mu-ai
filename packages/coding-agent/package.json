{
  "name": "mu-coding",
  "version": "0.38.0",
  "description": "The mu product: in-process agent SDK (harness) + terminal CLI. arya imports the SDK; the terminal runs the `mu` bin.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaetan-puleo/mu-ai.git",
    "directory": "packages/coding-agent"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "mu": "./bin/coding-agent.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx bin/coding-agent.ts",
    "dev:tui-debug": "MU_TUI_DEBUG_LOG=/tmp/mu-tui.log NODE_ENV=development tsx bin/coding-agent.ts",
    "start": "tsx bin/coding-agent.ts",
    "build": "tsup"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "mu": "./dist/coding-agent.js"
    }
  },
  "dependencies": {
    "@swc/wasm-typescript": "^1.15.0",
    "cli-highlight": "^2.1.11",
    "croner": "^9.0.0",
    "mu-ai-tools": "workspace:*",
    "mu-core": "workspace:*",
    "mu-local-provider": "workspace:*",
    "mu-tui": "workspace:*",
    "yaml": "^2.6.1"
  }
}
