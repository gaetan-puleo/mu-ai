{
  "name": "mu-webfetch",
  "version": "0.35.0",
  "description": "Webfetch tool for mu — fetches a URL and returns it as markdown by default.",
  "type": "module",
  "main": "./src/plugin.ts",
  "types": "./src/plugin.ts",
  "exports": {
    ".": "./src/plugin.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/plugin.ts --format esm --dts --clean"
  },
  "publishConfig": {
    "main": "./dist/plugin.js",
    "types": "./dist/plugin.d.ts",
    "exports": {
      ".": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    }
  },
  "dependencies": {
    "mu-core": "workspace:*",
    "mu-harness": "workspace:*",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6"
  }
}
