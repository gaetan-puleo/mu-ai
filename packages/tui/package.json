{
  "name": "mu-tui",
  "version": "0.38.0",
  "description": "Terminal UI engine for mu hosts: input parser, capability detector, layout/render core, components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaetan-puleo/mu-ai.git",
    "directory": "packages/tui"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
