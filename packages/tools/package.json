{
  "name": "mu-ai-tools",
  "version": "0.38.2",
  "description": "Shared filesystem + shell tools (read, write, edit, bash, list) for mu hosts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaetan-puleo/mu-ai.git",
    "directory": "packages/tools"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "mu-core": "workspace:*"
  }
}
