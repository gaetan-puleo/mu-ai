{
  "name": "mu-core",
  "version": "0.36.0",
  "description": "Standalone multimodal agentic loop: content, messages, tools, provider interface, createAgent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaetan-puleo/mu-ai.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
