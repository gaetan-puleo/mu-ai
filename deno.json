{
  "workspace": ["packages/*"],
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "deno run -A --sloppy-imports packages/coding-agent/bin/coding-agent.ts",
    "dev:tui-debug": "MU_TUI_DEBUG_LOG=/tmp/mu-tui.log deno run -A --sloppy-imports packages/coding-agent/bin/coding-agent.ts",
    "start": "deno run -A --sloppy-imports packages/coding-agent/bin/coding-agent.ts",
    "check": "deno check --sloppy-imports",
    "test": "deno test -A --sloppy-imports",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "build:npm": "deno run -A --sloppy-imports scripts/build_npm.ts",
    "publish": "deno run -A --sloppy-imports scripts/publish.ts",
    "publish:npm": "bash scripts/publish-npm.sh",
    "compile": "deno run -A --sloppy-imports scripts/compile.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@swc/wasm-typescript": "npm:@swc/wasm-typescript@^1.15.0",
    "cli-highlight": "npm:cli-highlight@^2.1.11",
    "croner": "npm:croner@^9.0.0",
    "ws": "npm:ws@^8.18.0"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-sloppy-imports", "require-await", "no-empty"]
    }
  },
  "exclude": ["**/dist", "**/node_modules", "**/npm"]
}
