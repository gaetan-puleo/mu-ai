{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true,
    "types": ["node"]
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/local-provider" },
    { "path": "packages/tools" },
    { "path": "packages/webfetch" },
    { "path": "packages/coding-agent" },
    { "path": "packages/tui" }
  ]
}
